{
  "name": "poke-fun-slides",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "slidev build",
    "dev": "slidev --open",
    "export": "slidev export"
  },
  "dependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "slidev-theme-kotlin": "^0.13.0",
    "vue": "^3.5.33"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "JetBrains Sans,Inter",
        "mono": "JetBrains Mono Local,JetBrains Mono",
        "local": "JetBrains Sans,JetBrains Mono Local",
        "weights": "400,700,800",
        "italic": true
      }
    }
  }
}
